# CodeAlpha Task 4 — example local Suricata rules
# Validate with your installed Suricata version before use.
# These are low-risk training signatures; only test on authorized lab traffic.
alert http any any -> any any (msg:"CODEALPHA HTTP test request observed"; flow:established,to_server; http.method; content:"GET"; sid:1000001; rev:1;)
alert dns any any -> any 53 (msg:"CODEALPHA DNS query observed"; dns.query; content:"example.com"; nocase; sid:1000002; rev:1;)
alert tcp any any -> any 4444 (msg:"CODEALPHA lab TCP port 4444 observed"; flags:S; sid:1000003; rev:1;)
